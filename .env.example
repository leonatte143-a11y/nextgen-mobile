# Environment Configuration for KAIRO Mobile App
# Copy this file to the appropriate .env file for your development mode:
#  - .env.local       → Local physical device / emulator development
#  - .env.staging     → Staging environment (Railway backend)
#  - .env.production  → Production
#
# Then restart Expo: npx expo start --clear

# ═══════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT (Physical Device on same Wi-Fi)
# ═══════════════════════════════════════════════════════════════════
# 1. Find your Windows machine's IPv4 address: Run `ipconfig` in terminal
# 2. Replace X.X.X.X with your actual IP (e.g., 192.168.1.12)
# 3. Ensure backend is running and accessible: http://192.168.1.12:4000
# 4. Physical device and backend laptop MUST be on same Wi-Fi network
#
# Example for local development:
# EXPO_PUBLIC_API_URL=http://192.168.1.12:4000

# ═══════════════════════════════════════════════════════════════════
# STAGING / PRODUCTION (Railway Backend)
# ═══════════════════════════════════════════════════════════════════
# Example for Railway staging:
# EXPO_PUBLIC_API_URL=https://nexgen-backend-production.up.railway.app

# ═══════════════════════════════════════════════════════════════════
# Global Settings
# ═══════════════════════════════════════════════════════════════════

# Toggle real API vs mock services (1 = real API, 0 = mock)
EXPO_PUBLIC_USE_API=1

# Debug OTP display (DO NOT enable in production)
# When backend returns debugOtp, shows it on login/register screens
# Set to 1 to always show debug OTP (when backend provides it)
# Leave empty/0 to only show in development mode (__DEV__)
EXPO_PUBLIC_SHOW_DEBUG_OTP=0

# Enable partner onboarding question flow:
# Set to 0 to skip the optional partner academy questions during registration
# Set to 1 to restore the full question flow later
EXPO_PUBLIC_ENABLE_PARTNER_QUESTIONS=0
